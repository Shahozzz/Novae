{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "outDir": "dist"
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*"
  ]
}